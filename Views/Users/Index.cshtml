@model List<MaintenanceRequestSystem.DTOs.Users.UserDto>
@{
    ViewData["Title"] = "Users Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2 text-primary"></i>User Management</h2>
    <span class="badge bg-primary fs-6">@Model.Count Users</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Name</th><th>Email</th><th>Department</th><th>Roles</th><th>Requests</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td class="small">@user.Email</td>
                        <td class="small text-muted">@(user.Department ?? "-")</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge @(role == "Admin" ? "bg-danger" : role == "Technician" ? "bg-info" : "bg-success") me-1">
                                    @role
                                </span>
                            }
                        </td>
                        <td>@user.TotalRequests</td>
                        <td>
                            <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="d-flex gap-1">
                            <a href="/Users/Details/@user.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="/Users/Edit/@user.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (user.IsActive)
                            {
                                <form method="post" action="/Users/Deactivate/@user.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate">
                                        <i class="bi bi-person-dash"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="/Users/Activate/@user.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate">
                                        <i class="bi bi-person-check"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
