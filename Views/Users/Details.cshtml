@model MaintenanceRequestSystem.DTOs.Users.UserDto
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person me-2 text-primary"></i>@Model.FullName</h2>
    <a href="/Users" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header"><h5 class="mb-0">User Details</h5></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@(Model.Department ?? "-")</dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(Model.PhoneNumber ?? "-")</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>
                    <dt class="col-sm-4">Roles</dt>
                    <dd class="col-sm-8">@string.Join(", ", Model.Roles)</dd>
                    <dt class="col-sm-4">Total Requests</dt>
                    <dd class="col-sm-8">@Model.TotalRequests</dd>
                    <dt class="col-sm-4">Joined</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("MMMM d, yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
