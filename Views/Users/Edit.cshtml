@model MaintenanceRequestSystem.DTOs.Users.UpdateUserDto
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header"><h5 class="mb-0">Edit User</h5></div>
            <div class="card-body">
                <form asp-action="Edit" asp-controller="Users" asp-route-id="@ViewBag.UserId" method="post">
                    <input type="hidden" name="id" value="@ViewBag.UserId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control" maxlength="100" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold">Department</label>
                        <input asp-for="Department" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Save</button>
                        <a href="/Users" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
