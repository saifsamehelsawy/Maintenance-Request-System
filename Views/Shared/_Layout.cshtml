<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Maintenance Request System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        .sidebar { min-height: calc(100vh - 56px); background-color: #1e3a5f; }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background-color: rgba(255,255,255,.15); }
        .sidebar .nav-link i { margin-right: 8px; }
        .badge-status-Pending { background-color: #ffc107; color: #000; }
        .badge-status-Assigned { background-color: #0dcaf0; color: #000; }
        .badge-status-InProgress { background-color: #0d6efd; }
        .badge-status-Resolved { background-color: #198754; }
        .badge-status-Closed { background-color: #6c757d; }
        .badge-priority-Low { background-color: #198754; }
        .badge-priority-Medium { background-color: #0d6efd; }
        .badge-priority-High { background-color: #fd7e14; }
        .badge-priority-Critical { background-color: #dc3545; }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-dark bg-primary px-3">
            <a class="navbar-brand fw-bold" href="/Dashboard">
                <i class="bi bi-tools me-2"></i>Maintenance Request System
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-white small">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                    @foreach (var role in new[] { "Admin", "Technician", "Employee" })
                    {
                        if (User.IsInRole(role))
                        {
                            <span class="badge bg-light text-dark ms-1">@role</span>
                        }
                    }
                </span>
                <a href="/swagger/index.html" class="btn btn-outline-light btn-sm" target="_blank">
                    <i class="bi bi-code-slash me-1"></i>API Docs
                </a>
                <form method="post" action="/Account/Logout" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">
                <nav class="col-md-2 d-md-block sidebar py-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                               href="/Dashboard">
                                <i class="bi bi-speedometer2"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Requests" ? "active" : "")"
                               href="/Requests">
                                <i class="bi bi-clipboard-list"></i>Requests
                            </a>
                        </li>
                        @if (User.IsInRole("Employee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Requests/Create">
                                    <i class="bi bi-plus-circle"></i>New Request
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                                   href="/Categories">
                                    <i class="bi bi-tags"></i>Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                                   href="/Users">
                                    <i class="bi bi-people"></i>Users
                                </a>
                            </li>
                        }
                    </ul>
                </nav>

                <main class="col-md-10 ms-sm-auto px-md-4 py-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
