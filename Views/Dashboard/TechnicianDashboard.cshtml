@model MaintenanceRequestSystem.DTOs.Dashboard.TechnicianDashboardDto
@{
    ViewData["Title"] = "Technician Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-wrench me-2 text-primary"></i>My Dashboard</h2>
    <span class="badge bg-info fs-6">Technician</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold">@Model.AssignedToMe</div>
                <div>Assigned to Me</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold">@Model.InProgressByMe</div>
                <div>In Progress</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold">@Model.ResolvedByMe</div>
                <div>Resolved</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-secondary text-white">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold">@Model.ClosedByMe</div>
                <div>Closed</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header"><h5 class="mb-0">My Active Requests</h5></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Request #</th><th>Title</th><th>Status</th><th>Priority</th><th>Employee</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.MyActiveRequests)
                    {
                        <tr>
                            <td><code>@req.RequestNumber</code></td>
                            <td>@req.Title</td>
                            <td><span class="badge badge-status-@req.Status">@req.Status</span></td>
                            <td><span class="badge badge-priority-@req.Priority">@req.Priority</span></td>
                            <td>@req.EmployeeName</td>
                            <td><a href="/Requests/Details/@req.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                        </tr>
                    }
                    @if (!Model.MyActiveRequests.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No active requests assigned to you</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
