@model MaintenanceRequestSystem.DTOs.Dashboard.EmployeeDashboardDto
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-circle me-2 text-primary"></i>My Dashboard</h2>
    <a href="/Requests/Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>New Request
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold">@Model.MyTotalRequests</div>
                <div class="small">Total</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold">@Model.MyPendingRequests</div>
                <div class="small">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold">@Model.MyInProgressRequests</div>
                <div class="small">In Progress</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold">@Model.MyResolvedRequests</div>
                <div class="small">Resolved</div>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm bg-secondary text-white">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold">@Model.MyClosedRequests</div>
                <div class="small">Closed</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">My Recent Requests</h5>
        <a href="/Requests" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Request #</th><th>Title</th><th>Status</th><th>Priority</th><th>Created</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var req in Model.MyRecentRequests)
                    {
                        <tr>
                            <td><code>@req.RequestNumber</code></td>
                            <td>@req.Title</td>
                            <td><span class="badge badge-status-@req.Status">@req.Status</span></td>
                            <td><span class="badge badge-priority-@req.Priority">@req.Priority</span></td>
                            <td class="text-muted small">@req.CreatedAt.ToString("MMM d, yyyy")</td>
                            <td><a href="/Requests/Details/@req.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                        </tr>
                    }
                    @if (!Model.MyRecentRequests.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">
                            No requests yet. <a href="/Requests/Create">Create your first request</a>
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
